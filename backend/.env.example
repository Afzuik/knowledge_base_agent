# Optional: reuse an existing local SiliconFlow configuration (absolute path).
# WORKBENCH_MODEL_ENV=/absolute/path/to/legacy/.env

# This provider default is used only to inherit matching SiliconFlow endpoint keys.
LLM_PROVIDER=siliconflow

# LLM: DeepSeek OFFICIAL service. Fill its own key, never a SiliconFlow key.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_ENABLE_THINKING=false

# Embedding: SiliconFlow. If importing SILICONFLOW_API_KEY, the matching endpoint inherits it.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=4096
EMBEDDING_API_KEY=

# Reranker: SiliconFlow (optional; failure falls back to RRF).
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
RERANKER_API_KEY=
RERANKER_ENABLED=true

# Only enable when you intentionally need HTTP(S)_PROXY / ALL_PROXY.
MODEL_TRUST_ENV=false
